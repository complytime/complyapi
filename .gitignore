.uf/dewey/graph.db-shm
.uf/dewey/graph.db-wal
.uf/dewey/*.lock
.uf/dewey/cache/
.uf/dewey/dewey.log
.uf/replicator/*.db
.uf/replicator/*.db-shm
.uf/replicator/*.db-wal
.uf/replicator/*.lock
.uf/replicator/*.log
.uf/muti-mind/artifacts/
.uf/mx-f/data/
# Devcontainer — OS-specific, generated by uf sandbox init
.devcontainer/
